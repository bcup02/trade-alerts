+def one_check(result_for):
+    calls = {"n": 0}
+
+    def run(_ctx):
+        calls["n"] += 1
+        value = result_for(calls["n"])
+        if isinstance(value, Exception):
+            raise value
+        return value
+
+    return ow.Check("demo", "示範", ("f-x",), run)
