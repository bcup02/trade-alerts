+chipGroup(b,[{id:"all",label:"全部狀態",n:allRows()},{id:"pending",label:"只看未做",n:allRows("pending")},{id:"done",label:"已做",n:allRows("done")},{id:"n/a",label:"不適用",n:allRows("n/a")}],function(v){pick.state=v;apply();});
