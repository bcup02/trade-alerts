+def _page(title: str, body: str, data: dict[str, Any], script: str) -> str:
+    blob = json.dumps(data, ensure_ascii=False, sort_keys=True, indent=1).replace("</", "<\\/")
+    return (f"<title>{title}</title>\n{_FONTS}\n<style>{_CSS}</style>\n\n{body}\n\n"
