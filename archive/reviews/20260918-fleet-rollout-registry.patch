new file mode 100644
index 0000000..f89e516
--- /dev/null
+++ b/schemas/fleet-rollout-registry-v1.schema.json
@@ -0,0 +1,91 @@
+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://github.com/bcup02/trade-alerts/schemas/fleet-rollout-registry-v1.schema.json",
+  "title": "Fleet rollout registry v1",
+  "description": "Which fleet capability each of the four strategies actually has, and whether each catalog condition's behaviour and event-log wiring exist in the strategy that owns it. Anything not done is pending (with the phase it lands in and why) or n/a (with why). Cross-field rules (all four strategies listed, pending phases registered, one row per catalog code with the right owners) are enforced by trade_alerts.rollout_registry.registry_problems.",
+  "type": "object",
+  "required": ["registry_version", "catalog_version", "updated_at", "projects", "phases", "sources", "capabilities", "catalog"],
+  "additionalProperties": false,
+  "definitions": {
+    "status": {
+      "type": "object",
+      "required": ["state"],
+      "additionalProperties": false,
+      "properties": {
+        "state": {"enum": ["done", "pending", "n/a"]},
+        "evidence": {"type": "string", "minLength": 1, "description": "done: where it lives on the sources commit (file:line or tool name)."},
+        "phase": {"type": "string", "minLength": 1, "description": "pending: a key of phases."},
+        "reason": {"type": "string", "minLength": 1, "description": "pending / n/a: plain-language current state or why it does not apply."}
+      },
+      "allOf": [
+        {"if": {"properties": {"state": {"const": "done"}}}, "then": {"required": ["evidence"]}},
+        {"if": {"properties": {"state": {"const": "pending"}}}, "then": {"required": ["phase", "reason"]}},
+        {"if": {"properties": {"state": {"const": "n/a"}}}, "then": {"required": ["reason"]}}
+      ]
+    },
+    "per_project": {
+      "type": "object",
+      "minProperties": 1,
+      "propertyNames": {"enum": ["momentum", "seykota", "mycrypto", "btc-competition"]},
+      "additionalProperties": {"$ref": "#/definitions/status"}
+    }
+  },
+  "properties": {
+    "registry_version": {"const": "fleet-rollout-registry/v1"},
+    "catalog_version": {"type": "string"},
+    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
+    "note": {"type": "string"},
+    "sources": {
+      "description": "What 'done' is measured against: per strategy, the repo and the branch the live host deploys from, and the commit the file:line evidence refers to. Merged to development or running on the dev host is not done.",
+      "type": "object",
+      "required": ["momentum", "seykota", "mycrypto", "btc-competition"],
+      "additionalProperties": false,
+      "patternProperties": {
+        "^(momentum|seykota|mycrypto|btc-competition)$": {
+          "type": "object",
+          "required": ["repo", "branch", "commit"],
+          "additionalProperties": false,
+          "properties": {
+            "repo": {"type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$"},
+            "branch": {"const": "operations"},
+            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
+          }
+        }
+      }
+    },
+    "projects": {
+      "type": "object",
+      "required": ["momentum", "seykota", "mycrypto", "btc-competition"],
+      "additionalProperties": false,
+      "patternProperties": {".*": {"type": "string", "minLength": 1}}
+    },
+    "phases": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
+    "capabilities": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["id", "title", "description", "status"],
+        "additionalProperties": false,
+        "properties": {
+          "id": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
+          "title": {"type": "string", "minLength": 1},
+          "description": {"type": "string", "minLength": 1},
+          "status": {"$ref": "#/definitions/per_project"}
+        }
+      }
+    },
+    "catalog": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["code", "behaviour", "emits_event"],
+        "additionalProperties": false,
+        "properties": {
+          "code": {"type": "string", "pattern": "^(SEY|MOM|MYC|BTC|FLEET)\\.[A-Z][A-Z0-9_]*$"},
+          "behaviour": {"$ref": "#/definitions/per_project", "description": "Does the owning strategy do what the catalog entry's auto_action says?"},
+          "emits_event": {"$ref": "#/definitions/per_project", "description": "Does it write the condition to the shared fleet event log (the only way it reaches a plain-language notification)?"}
+        }
+      }
+    }
+  }
+}
