+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://github.com/bcup02/trade-alerts/schemas/fleet-glossary-v1.schema.json",
+  "title": "Fleet glossary v1",
+  "description": "One Chinese name per fleet concept, the English identifiers it corresponds to, and the retired names that must no longer appear in human-facing text.",
+  "type": "object",
+  "required": ["glossary_version", "updated_at", "entries"],
+  "additionalProperties": false,
+  "properties": {
+    "glossary_version": {"const": "fleet-glossary/v1"},
+    "updated_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
+    "note": {"type": "string"},
+    "entries": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "required": ["id", "category", "zh", "en", "definition", "retired"],
+        "additionalProperties": false,
+        "properties": {
+          "id": {"type": "string", "pattern": "^[a-z0-9_.-]+$"},
+          "category": {"type": "string", "minLength": 1},
+          "zh": {"type": "string", "minLength": 1, "description": "The one Chinese name to use."},
+          "en": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "English identifiers as they exist today (not renamed here)."},
+          "definition": {"type": "string", "minLength": 1, "description": "One plain-language sentence."},
+          "retired": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "Names that must no longer be used for this concept."},
+          "note": {"type": "string"}
+        }
+      }
+    }
+  }
+}
