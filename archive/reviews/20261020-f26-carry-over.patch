+    out = ow.check_sheet_tab_names(ctx(_tabs_with_momentum(status=status, trade_ago_minutes=30), _covered_before()))
+    assert "動能策略" in out.summary.split("還在等新交易：")[1] and "momentum" not in out.extra["covered"]
