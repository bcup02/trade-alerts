+def _proven_before(previous: Mapping[str, Any]) -> dict[str, str]:
+    """Event ids whose delivery record this check itself SAW (first message out, on time) in an earlier run, with that record's time.
+    Kept in the check's own ``extra`` so that, once ops-notify prunes the record, an event that was proven can be told apart from one that never was."""
