+
+def test_equity_each_ten_usdt_band_is_its_own_notice():
+    below = ow.check_crypto_equity(ctx(equity_remote(wallet=95.0, unrealized=-8.0)))        # equity 87.0
+    assert below.state == ow.OBSERVED and below.key == "band-80-90"
