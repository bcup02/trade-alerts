+{
+  "$schema": "http://json-schema.org/draft-07/schema#",
+  "$id": "https://github.com/bcup02/trade-alerts/schemas/fleet-ops-export-v1.schema.json",
+  "title": "Fleet ops export v1",
+  "description": "One strategy's snapshot of what its operator should hear about, rewritten whole by trade_alerts.ops_export.write_ops_export into the strategy's audit/ops_export.json and relayed by ops-notify. notices are the notifying (R1-R4) fleet events of the last window_days, keyed by event_id so a reader sends each exactly once; open_requests is every still-open error request.",
+  "type": "object",
+  "required": ["export_version", "project", "generated_at", "window_days", "notices", "open_requests"],
+  "additionalProperties": false,
+  "properties": {
+    "export_version": {"const": "fleet-ops-export/v1"},
+    "project": {"type": "string", "enum": ["seykota", "momentum", "mycrypto", "btc-competition", "fleet"]},
+    "generated_at": {"type": "string", "format": "date-time", "description": "UTC; a reader treats an export that stops refreshing as STALE."},
+    "window_days": {"type": "integer", "minimum": 1},
+    "notices": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["event_id", "recorded_at", "code", "risk_tier", "critical", "text"],
+        "additionalProperties": false,
+        "properties": {
+          "event_id": {"type": "string", "minLength": 1},
+          "recorded_at": {"type": ["string", "null"]},
+          "code": {"type": "string", "pattern": "^(SEY|MOM|MYC|BTC|FLEET)\\.[A-Z][A-Z0-9_]*$"},
+          "risk_tier": {"enum": ["R1", "R2", "R3", "R4"]},
+          "critical": {"type": "boolean", "description": "true exactly when risk_tier is R4."},
+          "text": {"type": "string", "minLength": 1, "description": "Complete plain-language message body; the reader adds only the strategy label and times."}
+        }
+      }
+    },
+    "open_requests": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["request_id", "fingerprint", "code", "risk_tier", "opened_at", "summary", "what", "direction", "steps", "handling_started_at"],
+        "additionalProperties": false,
+        "properties": {
+          "request_id": {"type": "string", "minLength": 1},
+          "fingerprint": {"type": "string", "minLength": 1},
+          "code": {"type": "string", "pattern": "^(SEY|MOM|MYC|BTC|FLEET)\\.[A-Z][A-Z0-9_]*$"},
+          "risk_tier": {"enum": ["R1", "R2", "R3", "R4"]},
+          "opened_at": {"type": "string"},
+          "summary": {"type": "string"},
+          "what": {"type": ["string", "null"], "description": "Catalog operator_message.what, or null when the entry has none yet."},
