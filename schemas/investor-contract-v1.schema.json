{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bcup02/trade-alerts/blob/main/schemas/investor-contract-v1.schema.json",
  "title": "Trade Alerts Investor Contract v1",
  "$ref": "#/$defs/event",
  "$defs": {
    "version": { "type": "string", "const": "1.0" },
    "mode": { "type": "string", "enum": ["DRY_RUN", "PAPER", "LIVE"] },
    "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
    "event": {
      "type": "object",
      "required": ["schema_version", "event_id", "event_type", "project_id", "project_name", "occurred_at", "execution_mode", "severity", "message"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "event_id": { "type": "string", "minLength": 1 },
        "event_type": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "project_name": { "type": "string", "minLength": 1 },
        "occurred_at": { "type": "string", "format": "date-time" },
        "execution_mode": { "$ref": "#/$defs/mode" },
        "severity": { "$ref": "#/$defs/severity" },
        "message": { "type": "string" },
        "data": { "type": "object", "additionalProperties": true },
        "presentation": {
          "type": "object",
          "properties": {
            "format": { "type": "string" },
            "text": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
