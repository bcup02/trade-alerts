{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bcup02/trade-alerts/schemas/fleet-rollout-registry-v1.schema.json",
  "title": "Fleet rollout registry v1",
  "description": "Which fleet capability each of the four strategies actually has, and whether each catalog condition's behaviour and event-log wiring exist in the strategy that owns it. Anything not done is pending (with the phase it lands in and why) or n/a (with why). Cross-field rules (all four strategies listed, pending phases registered, one row per catalog code with the right owners) are enforced by trade_alerts.rollout_registry.registry_problems.",
  "type": "object",
  "required": [
    "registry_version",
    "catalog_version",
    "updated_at",
    "projects",
    "phases",
    "sources",
    "capabilities",
    "catalog"
  ],
  "additionalProperties": false,
  "definitions": {
    "status": {
      "type": "object",
      "required": [
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "done",
            "pending",
            "n/a"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "done: where it lives on the sources commit (file:line or tool name)."
        },
        "phase": {
          "type": "string",
          "minLength": 1,
          "description": "pending: a key of phases."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "pending / n/a: plain-language current state or why it does not apply."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "done"
              }
            }
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          },
          "then": {
            "required": [
              "phase",
              "reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "n/a"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "per_project": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "momentum",
          "seykota",
          "mycrypto",
          "btc-competition"
        ]
      },
      "additionalProperties": {
        "$ref": "#/definitions/status"
      }
    }
  },
  "properties": {
    "registry_version": {
      "const": "fleet-rollout-registry/v1"
    },
    "catalog_version": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "note": {
      "type": "string"
    },
    "sources": {
      "description": "What 'done' is measured against: per strategy, the repo and the branch the live host deploys from, and the commit the file:line evidence refers to. Merged to development or running on the dev host is not done.",
      "type": "object",
      "required": [
        "momentum",
        "seykota",
        "mycrypto",
        "btc-competition"
      ],
      "additionalProperties": false,
      "patternProperties": {
        "^(momentum|seykota|mycrypto|btc-competition)$": {
          "type": "object",
          "required": [
            "repo",
            "branch",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "repo": {
              "type": "string",
              "pattern": "^[\\w.-]+/[\\w.-]+$"
            },
            "branch": {
              "const": "operations"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            }
          }
        }
      }
    },
    "projects": {
      "type": "object",
      "required": [
        "momentum",
        "seykota",
        "mycrypto",
        "btc-competition"
      ],
      "additionalProperties": false,
      "patternProperties": {
        ".*": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "$ref": "#/definitions/per_project"
          }
        }
      }
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "behaviour",
          "emits_event"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^(SEY|MOM|MYC|BTC|FLEET)\\.[A-Z][A-Z0-9_]*$"
          },
          "behaviour": {
            "$ref": "#/definitions/per_project",
            "description": "Does the owning strategy do what the catalog entry's auto_action says?"
          },
          "emits_event": {
            "$ref": "#/definitions/per_project",
            "description": "Does it write the condition to the shared fleet event log (the only way it reaches a plain-language notification)?"
          }
        }
      }
    },
    "recent_changes": {
      "type": "array",
      "description": "What the most recent registry edit touched -- replaced wholesale each time the registry changes, never appended to, so the highlighted set on the human page always reflects only the latest edit (a visual 'did my update actually land' signal). Two kinds of entry: type=completed (default) is a cell that flipped to done/n-a, checked against the live registry so it can't point at something still pending; type=added is a brand-new capability or catalog row this edit introduced, which by definition has no project-specific done/n-a cell to check yet -- both render in the 'recently changed' summary, completed cells additionally get the gold 'recent' dot. Omit or set to [] when nothing from the latest edit remains current.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "cap",
              "rule"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "capability id (kind=cap) or catalog code (kind=rule)."
          },
          "type": {
            "enum": [
              "completed",
              "added"
            ],
            "default": "completed",
            "description": "completed: an existing cell just flipped to done/n-a (needs project, checked against current state). added: this whole capability/catalog row is new in this edit (no cell check, project optional)."
          },
          "project": {
            "enum": [
              "momentum",
              "seykota",
              "mycrypto",
              "btc-competition"
            ],
            "description": "Which strategy's cell/row this is about. Required for type=completed; optional for type=added."
          },
          "aspect": {
            "enum": [
              "behaviour",
              "emits_event"
            ],
            "description": "type=completed, kind=rule only: which cell of that row changed."
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "One short line shown in the 'recently changed' summary."
          }
        },
        "allOf": [
          {
            "if": {
              "not": {
                "properties": {
                  "type": {
                    "const": "added"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "then": {
              "required": [
                "project"
              ]
            }
          },
          {
            "if": {
              "allOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "rule"
                    }
                  }
                },
                {
                  "not": {
                    "properties": {
                      "type": {
                        "const": "added"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  }
                }
              ]
            },
            "then": {
              "required": [
                "aspect"
              ]
            }
          }
        ]
      }
    }
  }
}
